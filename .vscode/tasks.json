{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build ViGEm Server",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-I", "${workspaceFolder}/include",
                "${workspaceFolder}/VirtualControllerServer.cpp",
                "${workspaceFolder}/src/ViGEmClient.cpp",
                "-o", "${workspaceFolder}/VirtualControllerServer.exe",
                "-lsetupapi",
                "-lws2_32"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}